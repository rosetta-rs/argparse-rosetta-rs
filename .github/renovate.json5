{
  schedule: [
    'before 5am on the first day of the month',
  ],
  semanticCommits: 'enabled',
  configMigration: true,
  dependencyDashboard: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      matchCurrentVersion: '>=0.1.0',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      groupName: 'compatible',
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchCurrentVersion: '>=1.0.0',
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
      groupName: 'compatible',
    },
  ],
}
